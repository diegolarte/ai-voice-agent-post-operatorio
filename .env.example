# ---------------------------------------------------------------------------
# Centinela — configuración
# Copia este archivo a `.env` y completa tu clave. Es lo ÚNICO obligatorio.
# ---------------------------------------------------------------------------

# Clave de Google AI Studio (nivel gratuito): https://aistudio.google.com/app/apikey
# Necesaria para la voz y el razonador clínico. NO para los embeddings — esos
# corren localmente (BGE-M3) y no requieren clave ni conexión después de la
# primera descarga.
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# Todo lo de abajo tiene valores por defecto sensatos. No necesitas tocarlo.
# ---------------------------------------------------------------------------

# Modelo de voz en tiempo real (familia Gemini Flash — compuerta G3)
LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025

# Modelo de razonamiento clínico fundamentado (familia Gemini Flash — compuerta G3)
# gemini-2.5-flash fue retirado para cuentas nuevas. gemini-2.5-flash-lite
# responde en ~1-1.5s sin necesitar thinkingConfig (los sucesores 3.5/3.6 sin
# thinkingBudget tardan 4-20s, y con thinkingBudget:0 devuelven HTTP 400).
REASONER_MODEL=gemini-2.5-flash-lite

# Modelo de embeddings para el RAG — local, vía ONNX/transformers.js (libre
# según stack-tecnico.md §1). Se descarga una sola vez (~544 MB) al primer
# arranque del servidor y queda cacheado en disco.
EMBEDDING_MODEL=Xenova/bge-m3
EMBEDDING_DIM=1024

# Voz del agente: Zephyr | Puck | Charon | Kore | Fenrir | Aoede | Leda | Orus
LIVE_VOICE=Leda

# Puerto del backend
PORT=8787

# Recuperación — RAG_MIN_SCORE calibrado con BGE-M3 sobre el corpus completo
# (npm run eval:retrieval): separa "dentro de corpus" (min 0.722) de "fuera de
# corpus" (max 0.708) sin solape en la muestra de prueba.
RAG_TOP_K=6
RAG_MIN_SCORE=0.71
